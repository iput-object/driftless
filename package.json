{
  "name": "driftless",
  "version": "0.1.0",
  "private": true,
  "description": "Living docs for multi-repo teams — Cloudflare or fully local",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:worker && npm run build:dashboard",
    "build:worker": "tsc -p tsconfig.worker.json --noEmit && wrangler deploy --dry-run --outdir=dist/worker",
    "build:dashboard": "npm run build --workspace=dashboard",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && npm run typecheck --workspace=dashboard",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "db:migrate:local": "wrangler d1 migrations apply driftless --local",
    "build:cli": "node scripts/build-cli.mjs",
    "driftless": "tsx src/local/cli.ts"
  },
  "workspaces": [
    "dashboard",
    "packages/cli"
  ],
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.0",
    "hono": "^4.6.8",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.17.19": true,
    "workerd@1.20250718.0": true,
    "sharp@0.33.5": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "bin": {
    "driftless": "./packages/cli/bin/driftless.js"
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "packages/cli/bin",
    "dashboard/dist",
    "assets",
    "README.md",
    "LICENSE",
    "docs"
  ]
}
